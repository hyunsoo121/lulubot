# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
BOT_OWNER_ID=
# 설정하면 서버 참가 환영 메시지에 "서포트 서버" 버튼이 추가됨 (없으면 버튼 생략)
SUPPORT_SERVER_URL=

# Riot API
RIOT_API_KEY=
RIOT_TXT_CONTENT=

# PostgreSQL (프로덕션: docker-compose.prod.yml의 postgres 컨테이너를 가리킴 — 호스트는 서비스명 "postgres")
POSTGRES_USER=lulubot
POSTGRES_PASSWORD=
POSTGRES_DB=lulubot
DATABASE_URL=postgresql://lulubot:password@localhost:5432/lulubot

# Redis
REDIS_URL=redis://localhost:6379

# Express
PORT=3000
EXPRESS_SECRET=

# Environment
NODE_ENV=development
